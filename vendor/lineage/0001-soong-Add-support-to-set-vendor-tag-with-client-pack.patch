From 1e6cbf4db0184f95cb3c9bdb4b74ea4baed3c205 Mon Sep 17 00:00:00 2001
From: Jake Weinstein <jake@aospa.co>
Date: Tue, 17 Oct 2023 14:53:21 +0900
Subject: [PATCH 1/3] soong: Add support to set vendor tag with client package
 name

* OEMs like OnePlus and Nothing detect camera package name to unlock features like 48mp.
* Use TARGET_CAMERA_PACKAGE_NAME to specify the package name.

Signed-off-by: AnierinB <anierin@evolution-x.org>
Signed-off-by: Saikrishna1504 <saikrishna26918@gmail.com>
---
 config/BoardConfigSoong.mk | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/config/BoardConfigSoong.mk b/config/BoardConfigSoong.mk
index cd65d4b2..c2c25167 100644
--- a/config/BoardConfigSoong.mk
+++ b/config/BoardConfigSoong.mk
@@ -31,6 +31,11 @@ endif
 ifneq ($(TARGET_BOOTANIMATION),)
 $(call soong_config_set,lineage_bootanimation,prebuilt_file,$(TARGET_BOOTANIMATION))
 endif
+
+# Camera
+ifneq ($(TARGET_CAMERA_PACKAGE_NAME),)
+    $(call soong_config_set,camera,package_name,$(TARGET_CAMERA_PACKAGE_NAME))
+endif
 
 # Charger
 lineage_charger_density := mdpi
-- 
